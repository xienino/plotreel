  "homepage": "./",
  "dependencies": {
    "@ant-design/icons": "5.2.5",
    "@ant-design/pro-components": "2.6.16",
    "@testing-library/jest-dom": "^6.1.2",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^29.5.4",
    "@types/node": "^20.5.7",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/typescript-estree": "^8.26.0",
    "antd": "5.19.0",
    "antd-img-crop": "4.22.0",
    "axios": "^1.7.2",
    "dayjs": "^1.11.11",
    "dotenv": "16.4.5",
    "dotenv-cli": "7.4.2",
    "eslint": "^8.0.0",
    "http-proxy-middleware": "^3.0.0",
    "lodash.debounce": "^4.0.8",
    "lodash.throttle": "^4.1.1",
    "moment": "^2.30.1",
    "prettier": "^3.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-infinite-scroll-component": "^6.1.0",
    "react-router-dom": "6.24.0",
    "react-scripts": "5.0.1",
    "sass": "^1.66.1",
    "typescript": "^5.2.2",
    "web-vitals": "^3.4.0"
  },
  "scripts": {
    "precommit": "eslint src/*",
    "dev": "react-scripts start",
    "frontend:dev": "set BUILD_PATH=../../gui&& react-scripts build",
    "build": "react-scripts build BUILD_PATH='../../gui'",
    "build:dev": "dotenv -e .env.development react-scripts build BUILD_PATH='../../gui",
    "build:test": "dotenv -e .env.test react-scripts build BUILD_PATH='../../gui",
    "frontend:test": "react-scripts test",
    "frontend:eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "run-script-os": "^1.1.6"
  },
  "proxy": "http://127.0.0.1:47845",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/*": [
      "prettier --write",
      "eslint --cache --fix",
      "git add"
    ]
  }
}
